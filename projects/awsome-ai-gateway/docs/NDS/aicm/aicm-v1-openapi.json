{
  "components": {
    "schemas": {
      "AicmDeactivateRequest": {
        "additionalProperties": false,
        "properties": {
          "global_sign_out": {
            "default": true,
            "title": "Global Sign Out",
            "type": "boolean"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }

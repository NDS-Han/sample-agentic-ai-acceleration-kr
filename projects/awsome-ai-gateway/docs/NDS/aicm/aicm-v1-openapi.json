        "required": [
          "reason"
        ],
        "title": "AicmDeactivateRequest",
        "type": "object"
      },
      "AicmDeactivateResponse": {
        "properties": {
          "cognito": {
            "title": "Cognito",
            "type": "string"
          },
          "revoked_key_count": {
            "title": "Revoked Key Count",
            "type": "integer"
          },
          "state": {
            "description": "deactivated | already_inactive",
            "title": "State",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "state",
          "cognito",
          "revoked_key_count"
        ],
        "title": "AicmDeactivateResponse",
        "type": "object"
      },
      "AicmLink": {
        "additionalProperties": false,
        "properties": {
          "attribute": {
            "default": "Cognito_Subject",
            "description": "SAML 쪽 식별 속성. Cognito_Subject = NameID(권장) 또는 매핑된 속성 이름(예: email)",
            "title": "Attribute",
            "type": "string"
          },
          "value": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "AicmLink",
        "type": "object"
      },
      "AicmProvisionRequest": {
        "additionalProperties": false,

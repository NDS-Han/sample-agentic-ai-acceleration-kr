            "title": "Display Name"
          },
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Groups",
            "type": "array"
          },
          "link": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AicmLink"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "email",
          "groups"
        ],
        "title": "AicmProvisionRequest",
        "type": "object"
      },
      "AicmProvisionResponse": {
        "properties": {
          "cognito_username": {
            "title": "Cognito Username",
            "type": "string"

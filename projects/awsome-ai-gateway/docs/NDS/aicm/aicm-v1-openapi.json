        "type": "object"
      },
      "AicmTokenIssueRequest": {
        "additionalProperties": false,
        "properties": {
          "allowed_cidrs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 16,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "호출 허용 원천 IP 대역. 생략 = 제한 없음",
            "title": "Allowed Cidrs"
          },
          "expiry_days": {
            "anyOf": [
              {
                "maximum": 365.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Days"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "rate_limit_per_min": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "write 등급 분당 상한 재정의",
            "title": "Rate Limit Per Min"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "AicmTokenIssueRequest",
        "type": "object"
      },
      "AicmTokenIssueResponse": {
        "properties": {
          "allowed_cidrs": {
            "anyOf": [
              {

            "title": "Id",
            "type": "string"
          },
          "integration": {
            "title": "Integration",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rate_limit_per_min": {
            "anyOf": [
              {
                "type": "integer"
              },

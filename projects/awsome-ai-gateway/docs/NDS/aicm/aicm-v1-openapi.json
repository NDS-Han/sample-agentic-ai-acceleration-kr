    "/aicm/v1/users/{user_id}/deactivate": {
      "post": {
        "description": "Idempotency-Key 헤더 필수(1–128자). 같은 키+같은 요청 → 저장된 응답 재생.",
        "operationId": "deactivate_user_aicm_v1_users__user_id__deactivate_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "description": "같은 키+같은 요청 → 저장된 응답 재생(Idempotent-Replayed: true). 다른 요청 → 422 idempotency_key_reused. 보존 7일.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AicmDeactivateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {

              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "token": {
            "description": "평문 토큰 — 발급/rotate 응답에서 1회만",
            "title": "Token",
            "type": "string"
          },
          "token_prefix": {
            "title": "Token Prefix",
            "type": "string"
          }
        },

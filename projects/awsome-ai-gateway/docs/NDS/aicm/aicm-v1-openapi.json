                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed Cidrs"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "integration": {
            "title": "Integration",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rate_limit_per_min": {

    "securitySchemes": {
      "adminJwt": {
        "bearerFormat": "JWT (human admin)",
        "scheme": "bearer",
        "type": "http"
      },
      "integrationToken": {
        "bearerFormat": "itg-<64 hex>",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "admin-api 의 /aicm/v1 라우터(AICM_API_ENABLED=true 일 때만 존재). 인증: Authorization: Bearer itg-<64 hex>(scope 지정 통합 토큰). 오류 봉투: {\"error\": {\"type\", \"code\", \"message\", \"details\"?}}. 안내서: docs/NDS/aicm/README.md",
    "title": "LLM Gateway — AICM integration API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/aicm/v1/service-tokens": {
      "get": {
        "description": "호출 토큰과 같은 rotate 계보의 토큰만(다른 통합/계보는 보이지 않는다).",
        "operationId": "list_integration_tokens_aicm_v1_service_tokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AicmTokenListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "integrationToken": []
          }
        ],
        "summary": "List Integration Tokens",
        "tags": [
          "AICM Integration"
        ]
      },
      "post": {
        "description": "통합 토큰 발급 — **사람 admin(JWT) 전용**. 평문은 이 응답에서 1회만. scope 는 발급 후 넓힐 수 없다.",
        "operationId": "issue_integration_token_aicm_v1_service_tokens_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AicmTokenIssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AicmTokenIssueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "adminJwt": []
          }
        ],
        "summary": "Issue Integration Token",
        "tags": [
          "AICM Integration"
        ]
      }
    },
    "/aicm/v1/service-tokens/rotate": {
      "post": {
        "description": "Idempotency-Key 헤더 필수(1–128자). 같은 키+같은 요청 → 저장된 응답 재생.",
        "operationId": "rotate_integration_token_aicm_v1_service_tokens_rotate_post",
        "parameters": [
          {
            "description": "같은 키+같은 요청 → 저장된 응답 재생(Idempotent-Replayed: true). 다른 요청 → 422 idempotency_key_reused. 보존 7일.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AicmRotateResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "integrationToken": []
          }
        ],
        "summary": "Rotate Integration Token",
        "tags": [
          "AICM Integration"
        ]
      }
    },

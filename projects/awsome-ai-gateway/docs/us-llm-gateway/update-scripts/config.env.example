# ===========================================================================
# config.env — every value these scripts use, in one place.
#
# Sections are ordered by how likely you are to touch them:
#
#   1. MUST EDIT          exactly one value
#   2. INSTALLER DEFAULTS shown so you can verify them; edit only if your
#                         install deviated from the guide
#   3. AUTO-DISCOVERED    leave blank; the scripts look these up and print
#                         what they found
#   4. WHAT THE UPDATE DOES   the change itself — edit to target a different
#                         model or client
#   5. RARELY CHANGED     escape hatches
#
# Nothing here has side effects; it is read by _lib.sh with `source`.
# Run `bash 00-preflight-check.sh` after editing — it prints everything that
# resolved, including the discovered values, before any change is made.
# ===========================================================================


# ─── 1. MUST EDIT ──────────────────────────────────────────────────────────

# The only account these scripts may touch. Every script compares this with
# the live credentials and aborts on mismatch — this is the guard that stops
# an update landing in the wrong environment, which is why it has no default.
#   aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=""


# ─── 2. INSTALLER DEFAULTS ─────────────────────────────────────────────────
# These match what deployment/scripts/install-eks.sh produces. If your gateway
# was installed with it, they are already correct — they are listed anyway so
# you can see exactly which resources will be touched.

# Region the gateway runs in.
AWS_REGION="us-west-2"

# The argument you gave install-eks.sh (`install-eks.sh dev`). It selects the
# Secrets Manager path:  /llm-gateway/<env>/db/gateway-user
# Source: deployment/terraform/modules/aurora-postgresql/secrets.tf:10
DEPLOY_ENV="dev"

# Kubernetes namespace holding the gateway workloads.
# Source: install-eks.sh:48  (hardcoded, so identical on every install)
K8S_NAMESPACE="llm-gateway"

# Helm release name. Ingress objects are named after it:
#   <release>-gateway  <release>-admin-api  <release>-admin-ui
# Source: install-eks.sh:47  (hardcoded)
HELM_RELEASE="llm-gateway"

# Terraform directory holding this deployment's state — 07-client-values.sh
# reads the Cognito issuer URL and client id from its outputs. Blank => the
# standard repo layout: deployment/terraform/environments/llm-gateway-<env>.
TF_DIR=""

# Database name. Note it is "gateway", not "llm_gateway".
# Source: modules/aurora-postgresql/variables.tf:19  (terraform default)
DB_NAME="gateway"

# Secrets Manager entry with the gateway DB user ({username, password}).
# Blank => derived from DEPLOY_ENV as /llm-gateway/<env>/db/gateway-user.
# Set explicitly only if your secret sits somewhere else.
DB_SECRET_ID=""


# ─── 3. AUTO-DISCOVERED ────────────────────────────────────────────────────
# Leave these blank. They differ per install and per region, so hardcoding
# them is how you end up pointing at the wrong resource. The scripts resolve
# them at runtime and 00-preflight-check.sh prints what it found — check that
# output rather than filling these in.
#
# Also discovered, and not configurable at all:
#   gateway ALB name / DNS / security group   (from the gateway Ingress)
#   ingress names                             (from HELM_RELEASE)

# RDS proxy or cluster endpoint. Blank => looked up in RDS by name.
DB_HOST=""

# CloudFront managed prefix list (com.amazonaws.global.cloudfront.origin-facing).
# Blank => resolved by name. The ID is different in every region, so a value
# copied from another environment would silently be wrong.
CF_PREFIX_LIST=""


# ─── 4. WHAT THE UPDATE DOES ───────────────────────────────────────────────
# The actual change. Edit these to register a different model, or if your
# deployment names the Cowork client differently.

# --- 02-add-opus5-model.sh ---

# Alias clients will request (what goes in Cowork's inferenceModels).
MODEL_ALIAS="claude-opus-5"

# Bedrock model id behind that alias. Opus 5 is INFERENCE_PROFILE-only, so it
# needs a geo prefix — "us." for US deployments. Confirm it is callable in
# your region before running 02:
#   aws bedrock list-inference-profiles --region us-west-2 \
#     --query "inferenceProfileSummaries[?contains(inferenceProfileId,'opus')]"
MODEL_PROVIDER_ID="us.anthropic.claude-opus-5"

# Shown in the admin UI / model list.
MODEL_DISPLAY_NAME="Claude Opus 5"
MODEL_DESCRIPTION="Claude Opus 5 (US Geo)"

# --- Model prices (USD per 1,000 tokens) ---
#
# These are REQUIRED. 02 refuses to run without them, because a missing or
# wrong price fails silently: the request succeeds and the cost is recorded as
# $0, so the budget is bypassed with no error anywhere
# (router_service.py:51-52 substitutes 0 without raising).
#
# The values below are Claude Opus 5 published list price:
#     input  $5.00 / 1M tokens  ->  0.005 / 1K
#     output $25.00 / 1M tokens ->  0.025 / 1K
# and the three cache prices are the standard multipliers on the input price:
#     cache write 5m = input x 1.25   cache write 1h = input x 2
#     cache read     = input x 0.1
#
# Two things to know before trusting them:
#   1. These are Anthropic first-party API rates. Amazon Bedrock is priced
#      separately by AWS. In practice they have matched for Opus-tier models —
#      this codebase's own migrations seed exactly this set for every Opus-tier
#      model on Bedrock (0003_rename_cache_5m.py, 0004_add_opus_4_6.py,
#      0006_add_opus_4_8.py) — but confirm against your AWS bill.
#   2. They cannot be fetched automatically: the AWS Pricing API
#      (AmazonBedrock) only carries models up to Claude 3, and newer models are
#      not on the public pricing page either. So this is a value that goes
#      stale silently — MODEL_PRICE_ASOF is how anyone notices.
#
# For reference, Haiku 4.5 in the same seed set:
#     input 0.001000  output 0.005000
#     cache-5m 0.001250  cache-1h 0.002000  cache-read 0.000100
MODEL_PRICE_INPUT="0.005000"
MODEL_PRICE_OUTPUT="0.025000"
MODEL_PRICE_CACHE_5M="0.006250"
MODEL_PRICE_CACHE_1H="0.010000"
MODEL_PRICE_CACHE_READ="0.000500"

# When the prices above were checked (YYYY-MM-DD). Informational only, but it
# is the only way anyone can tell whether they have gone stale.
MODEL_PRICE_ASOF="2026-08-02"

# --- 01-fix-cowork-routing.sh ---

# Client key in model.routing_profiles. The seed uses "cowork".
COWORK_CLIENT="cowork"

# Backend the Cowork profile should use. "invoke" = in-account Bedrock, which
# is what any deployment without Mantle needs. Leaving it as the seeded
# "mantle" is exactly the problem 01 fixes.
COWORK_BACKEND="invoke"

# Region the Cowork profile points at. Blank => same as AWS_REGION.
COWORK_REGION=""


# ─── 5. RARELY CHANGED ─────────────────────────────────────────────────────

# Image used for the throwaway psql pod that runs SQL inside the cluster.
# Change only if your cluster cannot pull from Docker Hub — point it at an
# ECR mirror instead.
PSQL_IMAGE="postgres:16-alpine"

# created_by for rows this tooling inserts. Must exist in auth.users; the
# value below is the standard seed admin created by db/init/03_seed_data.sql.
SEED_ADMIN_UUID="00000000-0000-4000-a000-000000000010"

# Reference distribution for `03-create-cloudfront.sh --diff`, which compares
# the CloudFront config this tool would create against an existing one. Only
# useful if you have another working deployment and credentials for it.
REFERENCE_CF_DIST_ID=""
REFERENCE_CF_PROFILE=""

# US-06 (ALB HTTPS on a custom domain, docs/us-llm-gateway/ops/8-H-alb-https.md).
# Optional — 10-switch-https.sh / 11-route53-cname.sh also take --domain / --cert-arn.
# The certificate must be an ACM cert in AWS_REGION (same region as the ALB).
HTTPS_DOMAIN=""
HTTPS_CERT_ARN=""
